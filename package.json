{
  "name": "dory-notes",
  "publisher": "victor-luna",
  "displayName": "Dory Notes",
  "version": "0.0.7",
  "description": "A minimalist and versioned notes application for programmers.",
  "author": "Victor Luna <victor.luna.mullisaca@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/victorlunam",
  "homepage": "https://github.com/victorlunam/dory-notes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorlunam/dory-notes.git"
  },
  "bugs": {
    "url": "https://github.com/victorlunam/dory-notes/issues"
  },
  "categories": [
    "Notebooks",
    "Other"
  ],
  "keywords": [
    "notes",
    "markdown",
    "git",
    "versioning",
    "github",
    "productivity",
    "notebook"
  ],
  "qna": "https://github.com/victorlunam/dory-notes/issues",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "icon": "res/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dory-notes",
          "title": "Dory Notes",
          "icon": "res/dory.svg"
        }
      ]
    },
    "views": {
      "dory-notes": [
        {
          "id": "dory-notes-container",
          "name": "Better ideas 💡",
          "icon": "res/dory.svg"
        }
      ]
    },
    "configuration": {
      "title": "Dory Notes",
      "properties": {
        "dory-notes.autoCommitInterval": {
          "type": "number",
          "default": 28800000,
          "description": "Auto-commit interval in milliseconds (default: 8 hours)",
          "markdownDescription": "Auto-commit interval in milliseconds (default: 8 hours = 28,800,000 ms)"
        },
        "dory-notes.syncMode": {
          "type": "string",
          "enum": ["local", "github"],
          "description": "Sync mode for notes: 'local' for local-only, 'github' for GitHub sync",
          "markdownDescription": "Sync mode for notes: 'local' for local-only, 'github' for GitHub sync"
        }
      }
    },
    "commands": [
      {
        "command": "dory-notes.login",
        "title": "Login",
        "category": "Dory"
      },
      {
        "command": "dory-notes.syncWithGitHub",
        "title": "Sync with GitHub",
        "icon": "$(sync)"
      },
      {
        "command": "dory-notes.chooseLocal",
        "title": "Choose Local Mode",
        "enablement": "false"
      },
      {
        "command": "dory-notes.chooseGitHub",
        "title": "Choose GitHub Mode",
        "enablement": "false"
      },
      {
        "command": "dory-notes.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "dory-notes.openNote",
        "title": "Open Note",
        "icon": "$(open-preview)"
      },
      {
        "command": "dory-notes.newNote",
        "title": "New Note",
        "icon": "$(new-file)"
      },
      {
        "command": "dory-notes.newFileInFolder",
        "title": "New File",
        "icon": "$(new-file)"
      },
      {
        "command": "dory-notes.rename",
        "title": "Rename",
        "icon": "$(edit)"
      },
      {
        "command": "dory-notes.delete",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "dory-notes.newFolder",
        "title": "New Folder",
        "icon": "$(new-folder)"
      },
      {
        "command": "dory-notes.newFolderInFolder",
        "title": "New Folder",
        "icon": "$(new-folder)"
      }
    ],
    "viewsWelcome": [
      {
        "view": "dory-notes-container",
        "contents": "Welcome to Dory Notes! 🐠✨\n\nChoose how you want to sync your notes:\n\n[Use Local Mode](command:dory-notes.chooseLocal) - Store notes locally only\n[Connect with GitHub](command:dory-notes.chooseGitHub) - Sync notes to GitHub",
        "when": "config:dory-notes.syncMode == '' || !config:dory-notes.syncMode"
      },
      {
        "view": "dory-notes-container",
        "contents": "You haven't taken notes yet, it's time to start jotting down your code ideas! 🚀✨\n[create note](command:dory-notes.newNote)",
        "when": "config:dory-notes.syncMode != '' && config:dory-notes.syncMode"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dory-notes.syncWithGitHub",
          "when": "view == dory-notes-container",
          "group": "navigation@1"
        },
        {
          "command": "dory-notes.refresh",
          "when": "view == dory-notes-container",
          "group": "navigation@2"
        },
        {
          "command": "dory-notes.newNote",
          "when": "view == dory-notes-container",
          "group": "navigation@3"
        },
        {
          "command": "dory-notes.newFolder",
          "when": "view == dory-notes-container",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "dory-notes.newFileInFolder",
          "when": "view == dory-notes-container && viewItem == directory",
          "group": "1_creation@1"
        },
        {
          "command": "dory-notes.newFolderInFolder",
          "when": "view == dory-notes-container && viewItem == directory",
          "group": "1_creation@2"
        },
        {
          "command": "dory-notes.rename",
          "when": "view == dory-notes-container && (viewItem == file || viewItem == directory)",
          "group": "2_modification@1"
        },
        {
          "command": "dory-notes.delete",
          "when": "view == dory-notes-container && (viewItem == file || viewItem == directory)",
          "group": "2_modification@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dory-notes.rename",
        "key": "F2",
        "when": "view == dory-notes-container && viewItem && !inputFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node",
    "build": "npm run -S esbuild-base -- --sourcemap",
    "build:extension": "npm run build && vsce package",
    "watch": "npm run -S esbuild-base -- --sourcemap --watch",
    "lint": "eslint . --ext ts,tsx",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octokit/rest": "^20.0.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.6.3",
    "@types/node": "18.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "esbuild": "^0.19.11",
    "eslint": "^8.56.0",
    "eslint-ts-patch": "^8.56.0-0",
    "ovsx": "^0.10.6",
    "typescript": "^5.3.3",
    "vsce": "^2.15.0"
  }
}
